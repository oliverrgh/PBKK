<Window x:Class="StudentManagement.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Student Management System" 
        Width="1200" Height="750" 
        WindowStartupLocation="CenterScreen">
    
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!-- Header -->
        <Border Grid.Row="0" Background="#1565c0" CornerRadius="10" Padding="20" Margin="0,0,0,15">
            <StackPanel>
                <TextBlock Text="STUDENT MANAGEMENT SYSTEM" Foreground="White" FontSize="28" FontWeight="Bold"/>
                <TextBlock Text="Manage student data" Foreground="White" FontSize="14" Opacity="0.85"/>
            </StackPanel>
        </Border>

        <!-- Main Content Layout -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <!-- Form Input -->
            <StackPanel Grid.Column="0" Margin="0,0,20,0">
                <TextBlock Text="NIM"/>
                <TextBox Text="{Binding SelectedStudent.NIM, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>
                
                <TextBlock Text="Nama"/>
                <TextBox Text="{Binding SelectedStudent.Nama, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>
                
                <TextBlock Text="Jurusan"/>
                <ComboBox SelectedValue="{Binding SelectedStudent.Jurusan, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Content" Margin="0,0,0,10">
                    <ComboBoxItem>Informatika</ComboBoxItem>
                    <ComboBoxItem>Sistem Informasi</ComboBoxItem>
                </ComboBox>
                
                <TextBlock Text="Gender"/>
                <ComboBox SelectedValue="{Binding SelectedStudent.Gender, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Content" Margin="0,0,0,10">
                    <ComboBoxItem>Laki-laki</ComboBoxItem>
                    <ComboBoxItem>Perempuan</ComboBoxItem>
                </ComboBox>
                
                <TextBlock Text="Email"/>
                <TextBox Text="{Binding SelectedStudent.Email, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,15"/>
                
                <StackPanel Orientation="Horizontal">
                    <Button Content="Simpan" Command="{Binding SaveCommand}" Background="#1976D2" Foreground="White" Padding="20,10" Margin="0,0,10,0"/>
                    <Button Content="Reset" Command="{Binding ResetCommand}" Padding="20,10" Margin="0,0,10,0"/>
                    <Button Content="Hapus" Command="{Binding DeleteCommand}" Background="#D32F2F" Foreground="White" Padding="20,10"/>
                </StackPanel>
            </StackPanel>

            <!-- Statistics / Informasi Panel -->
            <Border Grid.Column="1" Background="#F5F5F5" Padding="15">
                <StackPanel>
                    <TextBlock Text="INFORMASI" FontSize="20" FontWeight="Bold" Margin="0,0,0,10"/>
                    <TextBlock Text="Total Mahasiswa"/>
                    <TextBlock Text="{Binding TotalStudents}" FontSize="32" FontWeight="Bold" Margin="0,0,0,10"/>

                    <TextBlock Text="Informatika"/>
                    <TextBlock Text="{Binding TotalInformatika}" FontSize="24" Margin="0,0,0,5"/>

                    <TextBlock Text="Sistem Informasi"/>
                    <TextBlock Text="{Binding TotalSistemInformasi}" FontSize="24" Margin="0,0,0,10"/>

                    <TextBlock Text="Laki-laki"/>
                    <TextBlock Text="{Binding TotalLakiLaki}" FontSize="24" Margin="0,0,0,5"/>

                    <TextBlock Text="Perempuan"/>
                    <TextBlock Text="{Binding TotalPerempuan}" FontSize="24"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Search Bar -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,20,0,10">
            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Width="300" Padding="10" Margin="0,0,10,0"/>
            <Button Content="Cari" Command="{Binding SearchCommand}" Padding="25,10"/>
        </StackPanel>

        <!-- DataGrid -->
        <DataGrid Grid.Row="3" ItemsSource="{Binding Students}" SelectedItem="{Binding SelectedStudent, Mode=TwoWay}" AutoGenerateColumns="False" IsReadOnly="True" Margin="0,10,0,0">
            <DataGrid.Columns>
                <DataGridTextColumn Header="NIM" Binding="{Binding NIM}"/>
                <DataGridTextColumn Header="Nama" Binding="{Binding Nama}"/>
                <DataGridTextColumn Header="Jurusan" Binding="{Binding Jurusan}"/>
                <DataGridTextColumn Header="Gender" Binding="{Binding Gender}"/>
                <DataGridTextColumn Header="Email" Binding="{Binding Email}"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>