<Window x:Class="StudentRegistration.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Student Registration"
        Height="760"
        Width="1240"
        MinHeight="650"
        MinWidth="980"
        WindowStartupLocation="CenterScreen"
        Background="#0B1017"
        FontFamily="Segoe UI"
        Foreground="#DCE6F2">
    <Window.Resources>
        <SolidColorBrush x:Key="InkBrush" Color="#DCE6F2"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#8EA1B5"/>
        <SolidColorBrush x:Key="BlueBrush" Color="#247BA0"/>
        <SolidColorBrush x:Key="YellowBrush" Color="#F4C542"/>
        <SolidColorBrush x:Key="LineBrush" Color="#293746"/>

        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource BlueBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#2C91B8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#1C607A"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#202C39"/>
            <Setter Property="Foreground" Value="#DCE6F2"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="12,13"/>
            <Setter Property="BorderThickness" Value="0,0,0,2"/>
            <Setter Property="BorderBrush" Value="{StaticResource YellowBrush}"/>
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#D0DCE8"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#344153"/>
                    <Setter Property="Foreground" Value="#F4C542"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#111923" BorderBrush="#263443" BorderThickness="0,0,1,0" Padding="22,26">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,34">
                    <Border Width="34" Height="34" CornerRadius="9" Background="#1D3342" BorderBrush="#2E647A" BorderThickness="1">
                        <TextBlock Text="SR" Foreground="{StaticResource YellowBrush}" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="STUDENT" FontSize="13" FontWeight="Bold" Foreground="{StaticResource InkBrush}"/>
                        <TextBlock Text="REGISTRATION" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Row="1" Margin="0,0,0,22">
                    <TextBlock Text="OVERVIEW" Foreground="#74899D" FontSize="10" FontWeight="Bold" Margin="2,0,0,10"/>
                    <Border Background="#192431" BorderBrush="#2B3A49" BorderThickness="1" CornerRadius="10" Padding="14,13">
                        <StackPanel>
                            <TextBlock Text="TOTAL REGISTERED" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="SemiBold"/>
                            <TextBlock x:Name="TotalStudentsText" Text="-" Foreground="{StaticResource YellowBrush}" FontSize="30" FontWeight="Bold" Margin="0,4,0,0"/>
                            <TextBlock Text="mahasiswa terdaftar" Foreground="{StaticResource MutedBrush}" FontSize="11"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Row="2">
                    <TextBlock Text="PROGRAM DISTRIBUTION" Foreground="#74899D" FontSize="10" FontWeight="Bold" Margin="2,0,0,8"/>
                    <StackPanel x:Name="ProgramStatisticsPanel"/>
                </StackPanel>

                <Border Grid.Row="4" Background="#17241F" BorderBrush="#29483C" BorderThickness="1" CornerRadius="9" Padding="11,10">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="ConnectionStatusDot" Width="8" Height="8" Fill="#74899D" VerticalAlignment="Center" Margin="0,0,9,0"/>
                        <TextBlock x:Name="ConnectionStatusText" Text="SYSTEM: CONNECTING" Foreground="#9BB7A7" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Margin="30,27,30,22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Margin="0,0,0,22">
                <Button Content="Refresh" Width="116" Height="39" DockPanel.Dock="Right" Click="RefreshButton_Click"/>
                <StackPanel>
                    <TextBlock Text="Registration Monitor" Foreground="{StaticResource InkBrush}" FontSize="25" FontWeight="Bold"/>
                    <TextBlock Text="Student database // StudentRegistrationDB" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,5,0,0"/>
                </StackPanel>
            </DockPanel>

            <Grid Grid.Row="1" Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Background="#141E29" BorderBrush="#2A3A4A" BorderThickness="1" CornerRadius="8" Padding="12,0" Height="42">
                    <DockPanel VerticalAlignment="Center">
                        <TextBlock Text="SEARCH" Foreground="#8297AB" FontSize="10" FontWeight="Bold" Margin="0,0,12,0" VerticalAlignment="Center"/>
                        <TextBox x:Name="SearchBox" TextChanged="SearchBox_TextChanged" Background="Transparent" BorderThickness="0" Foreground="{StaticResource InkBrush}" FontSize="13" VerticalContentAlignment="Center" ToolTip="Cari NRP, nama, program studi, atau alamat"/>
                    </DockPanel>
                </Border>
                <TextBlock Grid.Column="1" Text="LIVE FILTER // LOCAL" Foreground="#8297AB" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center" Margin="14,0,0,0"/>
            </Grid>

            <Border Grid.Row="2" Background="#121A24" BorderBrush="#293746" BorderThickness="1" CornerRadius="10" Padding="1">
                <DataGrid x:Name="StudentDataGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single" HeadersVisibility="Column" GridLinesVisibility="Horizontal" AlternatingRowBackground="#151F2A" RowBackground="#111923" BorderThickness="0" HorizontalGridLinesBrush="#263442" VerticalGridLinesBrush="Transparent" FontSize="12" RowHeight="41" Background="#111923">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding StudentId}" Width="55"/>
                        <DataGridTextColumn Header="NRP" Binding="{Binding NIM}" Width="105"/>
                        <DataGridTextColumn Header="NAMA MAHASISWA" Binding="{Binding Name}" Width="170"/>
                        <DataGridTextColumn Header="PROGRAM STUDI" Binding="{Binding ProgramName}" Width="170"/>
                        <DataGridTextColumn Header="TANGGAL LAHIR" Binding="{Binding BirthDate, StringFormat={}{0:dd/MM/yyyy}}" Width="115"/>
                        <DataGridTextColumn Header="ALAMAT" Binding="{Binding Address}" Width="*"/>
                        <DataGridTextColumn Header="NO. TELEPON" Binding="{Binding PhoneNumber}" Width="125"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <TextBlock x:Name="StatusText" Grid.Row="3" Margin="2,11,0,0" Foreground="{StaticResource MutedBrush}" FontSize="11" Text="Siap."/>
        </Grid>
    </Grid>
</Window>
